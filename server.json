{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Soflutionltd/simtrail",
  "title": "Simtrail",
  "description": "Drive iOS Simulators, iPhones, Android devices and macOS apps: UI snapshots, live viewer, recording.",
  "version": "3.11.3",
  "websiteUrl": "https://github.com/Soflutionltd/simtrail#readme",
  "repository": {
    "url": "https://github.com/Soflutionltd/simtrail",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "simtrail",
      "version": "3.11.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
